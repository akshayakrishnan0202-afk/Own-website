  </main>

  <!-- Script for Icons and Dynamic Project Filtering -->
  <script>
    lucide.createIcons();

    function filterProjects(category, buttonElement) {
      const buttons = document.querySelectorAll('.filter-btn');
      buttons.forEach(btn => {
        btn.classList.remove('bg-stone-900', 'text-white', 'shadow-xs');
        btn.classList.add('bg-white', 'border', 'border-stone-200', 'text-stone-700');
      });

      buttonElement.classList.remove('bg-white', 'border', 'border-stone-200', 'text-stone-700');
      buttonElement.classList.add('bg-stone-900', 'text-white', 'shadow-xs');

      const cards = document.querySelectorAll('.project-card');
      cards.forEach(card => {
        const cardCategory = card.getAttribute('data-category');
        if (category === 'all' || cardCategory === category) {
          card.classList.remove('hidden-card');
        } else {
          card.classList.add('hidden-card');
        }
      });
    }
  </script>
